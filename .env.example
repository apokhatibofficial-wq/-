# MEDLINK configuration. Copy to .env (chmod 600, owned by the service user) and fill in real values.
# DUMMY VALUES ONLY. Never commit .env, and never paste real secrets into chat, WhatsApp, tickets or the repo.
# Generate each secret locally:   openssl rand -base64 48

# ---- Database (PostgreSQL 16 in Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medlink
DB_OWNER_USER=medlink_owner
# Owner password: used only by `medlink migrate` and by the postgres container.
DB_PASSWORD=change-me-generate-with-openssl
# Password of the medlink_app role the API connects as (row-level security applies to it).
DB_APP_PASSWORD=change-me-generate-with-openssl
DB_SSLMODE=Disable

# ---- Keys (base64, at least 32 random bytes each)
SESSION_SIGNING_KEY=change-me-generate-with-openssl
TOTP_ENC_KEY=change-me-generate-with-openssl
DATA_PROTECTION_KEYS_PATH=/var/lib/medlink/keys

# ---- Email (activation and reset links only)
# Development: Mailpit (no credentials) on localhost:1025, UI at http://localhost:8025
# Production example (Resend SMTP): SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_TLS=ssl SMTP_USER=resend
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=
EMAIL_API_KEY=
EMAIL_FROM=MEDLINK <no-reply@medlink.website>

# ---- URLs
ADMIN_WEB_URL=http://localhost:5173
HOSPITAL_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Production: https://admin.medlink.website, https://app.medlink.website, and both in CORS_ORIGINS (comma-separated)

# ---- HTTP
# Cookies are Secure (__Host- prefix) unless set to false for plain-http local development.
COOKIE_SECURE=false
# Proxies allowed to set X-Forwarded-For (IPs or CIDRs). Docker stack: 172.30.0.0/24
TRUSTED_PROXIES=
AUTH_RATE_PER_IP_PER_MIN=20
AUTH_RATE_PER_NET24_PER_MIN=60

# ---- Hospitals
# IANA zone used for new hospitals until a per-hospital setting exists (open question for the owner).
DEFAULT_HOSPITAL_TIMEZONE=UTC

# ---- Caddy / HTTPS (production)
API_DOMAIN=api.medlink.website
ACME_EMAIL=ops@example.com

# ---- Backups (infra/backup)
# age PUBLIC key only. The private key stays offline with the owner.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-key
R2_ACCOUNT_ID=
R2_BUCKET=medlink-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- Windows app updates (phase 8): the app ships with this PUBLIC key only.
UPDATE_SIGNING_PUBLIC_KEY=
