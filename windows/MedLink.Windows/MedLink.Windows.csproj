<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF window of the MEDLINK Windows app. It only draws MedLink.App.Core, which holds the logic and is tested
       against the real API. Builds on Linux too (EnableWindowsTargeting) but runs only on Windows; CI runs it there. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ API surface for PackageManager (signed updates). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MedLink.Windows</RootNamespace>
    <AssemblyName>MEDLINK</AssemblyName>
    <Version>0.9.0</Version>
    <ApplicationIcon>Assets\medlink.ico</ApplicationIcon>
    <!-- Set by installer/build-msix.ps1: the Ed25519 public key that update.json must be signed with, and the feed.
         Empty key (development builds): the app never updates itself. -->
    <UpdatePublicKey Condition="'$(UpdatePublicKey)' == ''"></UpdatePublicKey>
    <UpdateFeed Condition="'$(UpdateFeed)' == ''">https://downloads.medlink.website/windows/</UpdateFeed>
    <Product>MEDLINK</Product>
    <Company>KHATIB TECHNICAL SOLUTIONS</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdatePublicKey</_Parameter1>
      <_Parameter2>$(UpdatePublicKey)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateFeed</_Parameter1>
      <_Parameter2>$(UpdateFeed)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MedLink.App.Core\MedLink.App.Core.csproj" />
    <!-- Renders the original SVG logos unchanged (BSD-3-Clause). -->
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.svg" />
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
