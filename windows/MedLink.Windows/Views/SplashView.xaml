<UserControl x:Class="MedLink.Windows.Views.SplashView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MedLink.Windows"
             Background="White" FlowDirection="LeftToRight">
  <Grid x:Name="Root" ClipToBounds="True" Background="#1a2d99">
    <!-- KHATIB min(420px, 60%), MEDLINK min(460px, 64%) as in the prototype; the window's minimum width keeps both at their maximum. -->
    <Image x:Name="Khatib" Source="{local:Logo khatib-logo-white.svg}" Width="420" Stretch="Uniform" Opacity="0"
           HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="KHATIB TECHNICAL SOLUTIONS">
      <Image.RenderTransform>
        <TransformGroup><ScaleTransform x:Name="KhatibScale" /><TranslateTransform x:Name="KhatibMove" /></TransformGroup>
      </Image.RenderTransform>
    </Image>
    <Image x:Name="Medlink" Source="{local:Logo medlink-logo-white.svg}" Width="460" Stretch="Uniform" Opacity="0"
           HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="MEDLINK">
      <Image.RenderTransform>
        <TranslateTransform x:Name="MedlinkMove" />
      </Image.RenderTransform>
    </Image>
    <!-- Progress bar: 180×3, white on 18% white, 56px from the bottom -->
    <Border Width="180" Height="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="0,0,0,56" Background="#2effffff" ClipToBounds="True">
      <Border x:Name="Bar" Width="0" HorizontalAlignment="Left" Background="White" CornerRadius="2" />
    </Border>
  </Grid>
</UserControl>
