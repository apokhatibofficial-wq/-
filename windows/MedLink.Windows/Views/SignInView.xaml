<UserControl x:Class="MedLink.Windows.Views.SignInView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Background="{StaticResource Surface}">
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="38*" MinWidth="340" />
        <ColumnDefinition Width="62*" />
      </Grid.ColumnDefinitions>
      <!-- Brand pane (#1a2d99): white MEDLINK logo (300px), description line; KHATIB logo and version at the bottom -->
      <Border Background="{StaticResource BrandDeep}" Padding="40">
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <svgc:SvgViewbox DockPanel.Dock="Left" Source="pack://application:,,,/Assets/khatib-logo-white.svg" Height="40" AutomationProperties.Name="KHATIB TECHNICAL SOLUTIONS" />
            <TextBlock DockPanel.Dock="Right" FlowDirection="LeftToRight" Foreground="#b9c2f0" FontSize="12" VerticalAlignment="Bottom">
              <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · Windows" />
            </TextBlock>
          </DockPanel>
          <StackPanel>
            <svgc:SvgViewbox Source="pack://application:,,,/Assets/medlink-logo-white.svg" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="MEDLINK" />
            <TextBlock Text="{Binding S.BrandLine}" Foreground="#d6dcff" FontSize="16" MaxWidth="340" HorizontalAlignment="Left" Margin="0,18,0,0" LineHeight="26" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Form -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="380" Margin="48" VerticalAlignment="Center">
          <Border Style="{StaticResource Chip}" Padding="12,6" Background="{Binding Online, Converter={StaticResource ConnBg}}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{Binding Online, Converter={StaticResource ConnDot}}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ConnectionText}" FontSize="13" FontWeight="Medium" Foreground="{Binding Online, Converter={StaticResource ConnFg}}" />
            </StackPanel>
          </Border>

          <TextBlock Margin="0,20,0,6" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Ink}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Text" Value="{Binding S.SignIn}" />
                <Style.Triggers><DataTrigger Binding="{Binding NeedTotp}" Value="True"><Setter Property="Text" Value="{Binding S.TotpTitle}" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Foreground="{StaticResource Muted}" LineHeight="22">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Text" Value="{Binding S.SignInSub}" />
                <Style.Triggers><DataTrigger Binding="{Binding NeedTotp}" Value="True"><Setter Property="Text" Value="{Binding S.TotpSub}" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <Border Margin="0,20,0,0" Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10"
                  Visibility="{Binding Info, Converter={StaticResource TextVis}}">
            <TextBlock Text="{Binding Info}" Foreground="#6b4a00" FontSize="13" />
          </Border>
          <Border Margin="0,20,0,0" Background="{StaticResource DangerBg}" BorderBrush="{StaticResource DangerBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10"
                  Visibility="{Binding Error, Converter={StaticResource TextVis}}" AutomationProperties.LiveSetting="Assertive">
            <TextBlock x:Name="ErrorText" Text="{Binding Error}" Foreground="{StaticResource DangerDark}" FontSize="13" />
          </Border>
          <Border Margin="0,20,0,0" Background="#fff8e6" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10"
                  Visibility="{Binding Online, Converter={StaticResource NotVis}}">
            <TextBlock Text="{Binding S.OfflineNote}" Foreground="#6b4a00" FontSize="13" />
          </Border>

          <!-- Email + password -->
          <StackPanel Margin="0,20,0,0" Visibility="{Binding NeedTotp, Converter={StaticResource NotVis}}">
            <TextBlock Text="{Binding S.Email}" FontWeight="Medium" Margin="0,0,0,6" />
            <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding S.Email}" />
            <TextBlock Text="{Binding S.Password}" FontWeight="Medium" Margin="0,20,0,6" />
            <Grid FlowDirection="LeftToRight">
              <PasswordBox x:Name="PasswordBox" Padding="10,0,70,0" PasswordChanged="OnPasswordChanged" KeyUp="OnKey" GotKeyboardFocus="OnKey"
                           AutomationProperties.Name="{Binding S.Password}" />
              <TextBox x:Name="PasswordText" Padding="10,0,70,0" Visibility="Collapsed" TextChanged="OnPasswordTextChanged" KeyUp="OnKey" />
              <Button Style="{StaticResource Link}" Content="{Binding ShowText}" Command="{Binding ToggleShowCommand}" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Margin="0,0,12,0" Click="OnToggleShow" />
            </Grid>
            <TextBlock x:Name="CapsHint" Text="{Binding S.Caps}" Foreground="#7a5200" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
          </StackPanel>

          <!-- 6-digit code step -->
          <StackPanel Margin="0,20,0,0" Visibility="{Binding NeedTotp, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding S.TotpLabel}" FontWeight="Medium" Margin="0,0,0,6" />
            <TextBox x:Name="TotpBox" Text="{Binding Totp, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}"
                     FontSize="20" MaxLength="6" AutomationProperties.Name="{Binding S.TotpLabel}" />
          </StackPanel>

          <Button Margin="0,20,0,0" Height="46" FontSize="15" Style="{StaticResource Primary}" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" IsDefault="True" />
          <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource Link}" Content="{Binding S.Forgot}" Command="{Binding ForgotCommand}"
                    Visibility="{Binding NeedTotp, Converter={StaticResource NotVis}}" />
            <Button DockPanel.Dock="Left" Style="{StaticResource Link}" Content="{Binding S.Back}" Command="{Binding BackCommand}"
                    Visibility="{Binding NeedTotp, Converter={StaticResource Vis}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Foreground="{StaticResource Muted}" Content="{Binding S.ConnSettings}" Command="{Binding ConnSettingsCommand}" />
          </DockPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Forgot password -->
    <Grid Background="#660f1a4a" Visibility="{Binding ForgotOpen, Converter={StaticResource Vis}}">
      <Border Background="White" CornerRadius="10" Padding="24" MaxWidth="440" VerticalAlignment="Center" Margin="16">
        <StackPanel>
          <TextBlock Text="{Binding S.ForgotTitle}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
          <TextBlock Text="{Binding S.ForgotBody}" Margin="0,14,0,0" LineHeight="22" />
          <Border Background="{StaticResource PageBg}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
            <TextBlock Text="{Binding WhatsAppMessage}" FontSize="13" LineHeight="21" />
          </Border>
          <Border Background="#fff8e6" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
            <TextBlock Text="{Binding S.ForgotWarn}" Foreground="#6b4a00" FontSize="13" />
          </Border>
          <UniformGrid Columns="2" Margin="0,14,0,0">
            <Button Style="{StaticResource Secondary}" Height="44" Margin="0,0,4,0" Content="{Binding S.Cancel}" Command="{Binding CloseForgotCommand}" />
            <Button Style="{StaticResource Primary}" Background="{StaticResource SuccessText}" BorderBrush="{StaticResource SuccessText}" Height="44" Margin="4,0,0,0"
                    Content="{Binding S.OpenWa}" Command="{Binding OpenWhatsAppCommand}" />
          </UniformGrid>
          <TextBlock Text="+43 681 81700732" FlowDirection="LeftToRight" Style="{StaticResource Note}" Margin="0,10,0,0" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Connection settings: the server address is shown read-only (set at installation) with a test button -->
    <Grid Background="#660f1a4a" Visibility="{Binding ConnOpen, Converter={StaticResource Vis}}">
      <Border Background="White" CornerRadius="10" Padding="24" MaxWidth="440" VerticalAlignment="Center" Margin="16">
        <StackPanel>
          <TextBlock Text="{Binding S.ConnSettings}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
          <TextBlock Text="{Binding S.ServerAddress}" Style="{StaticResource Label}" Margin="0,14,0,6" />
          <TextBlock Text="{Binding Server}" Style="{StaticResource MonoText}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding S.ServerNote}" Style="{StaticResource Note}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding ConnResult}" Margin="0,14,0,0" Visibility="{Binding ConnResult, Converter={StaticResource TextVis}}" />
          <UniformGrid Columns="2" Margin="0,14,0,0">
            <Button Style="{StaticResource Secondary}" Margin="0,0,4,0" Content="{Binding S.Close}" Command="{Binding CloseConnCommand}" />
            <Button Style="{StaticResource Primary}" Margin="4,0,0,0" Content="{Binding S.TestConnection}" Command="{Binding TestConnectionCommand}" />
          </UniformGrid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
