<UserControl x:Class="MedLink.Windows.Views.MainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Background="{StaticResource Surface}" SizeChanged="OnSize">
  <UserControl.Resources>
    <!-- Nav item: 9px 12px, radius 6; selected #e3e8fb / #1a2d99 / 600 -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="6" Padding="12,9" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#e3e8fb" />
                <Setter Property="Foreground" Value="{StaticResource BrandDeep}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#eef1fc" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterChipButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="999" Height="32" Padding="12,0" BorderThickness="1" BorderBrush="{StaticResource Border}" Background="White">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="l" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock x:Name="n" Text="{Binding Count}" FontSize="13" FontWeight="Medium" Opacity="0.8" Margin="6,0,0,0" Foreground="{StaticResource Text}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Brand}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brand}" />
                <Setter TargetName="l" Property="Foreground" Value="White" />
                <Setter TargetName="n" Property="Foreground" Value="White" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TargetChip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="999" Height="32" Padding="12,0" BorderThickness="1.5" BorderBrush="{StaticResource InputBorder}" Background="White">
              <TextBlock x:Name="l" Text="{Binding Label}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brand}" />
                <Setter TargetName="b" Property="Background" Value="{StaticResource Soft}" />
                <Setter TargetName="l" Property="Foreground" Value="{StaticResource BrandDeep}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="208" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left nav -->
    <Border Background="{StaticResource Thead}" BorderBrush="{StaticResource TheadBorder}" BorderThickness="0,0,1,0" Padding="10,14">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource TheadBorder}" BorderThickness="0,1,0,0" Padding="12,10,12,0">
          <StackPanel>
            <TextBlock Text="{Binding Email}" FontSize="13" FontWeight="SemiBold" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Note}" />
            <Button Style="{StaticResource Link}" Content="{Binding S.SignOut}" Command="{Binding SignOutCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <StackPanel>
          <svgc:SvgViewbox FlowDirection="LeftToRight" x:Name="NavLogo" Source="pack://application:,,,/Assets/medlink-logo.svg" Width="128" HorizontalAlignment="Left" Margin="8,2,8,8" AutomationProperties.Name="MEDLINK" />
          <TextBlock Text="{Binding HospitalName}" Style="{StaticResource Note}" Margin="8,0,8,10" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavCommand}" CommandParameter="0"
                       IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=0, Mode=OneWay}">
            <TextBlock Text="{Binding Nav[0]}" />
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavCommand}" CommandParameter="1"
                       IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=1, Mode=OneWay}">
            <TextBlock Text="{Binding Nav[1]}" />
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavCommand}" CommandParameter="2"
                       IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=2, Mode=OneWay}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding PendingCount}" FontSize="12" Foreground="{StaticResource Muted}" Visibility="{Binding HasPending, Converter={StaticResource Vis}}" />
              <TextBlock Text="{Binding Nav[2]}" />
            </DockPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavCommand}" CommandParameter="3"
                       IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=3, Mode=OneWay}">
            <TextBlock Text="{Binding Nav[3]}" />
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <!-- ============================== Appointments ============================== -->
      <DockPanel x:Name="Appointments" DataContext="{Binding Dashboard}">
        <!-- Toolbar: ‹ Today › · date · search · sync pill -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource TheadBorder}" BorderThickness="0,0,0,1" Padding="16,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource Small}" Width="32" Padding="0" Content="‹" Command="{Binding PrevCommand}" AutomationProperties.Name="Previous day" />
              <Button Style="{StaticResource Small}" Margin="4,0" Content="{Binding DataContext.S.Today, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding TodayCommand}" />
              <Button Style="{StaticResource Small}" Width="32" Padding="0" Content="›" Command="{Binding NextCommand}" AutomationProperties.Name="Next day" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Height="34" Cursor="Hand" Command="{Binding DataContext.SyncPage.SyncNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border CornerRadius="999" Padding="12,0" Background="{Binding DataContext.Connection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ConnBg}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding DataContext.Connection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ConnDot}}" />
                      <TextBlock Text="{Binding DataContext.PillText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap"
                                 Foreground="{Binding DataContext.Connection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ConnFg}}" />
                    </StackPanel>
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Grid DockPanel.Dock="Right" Width="240" Margin="10,0">
              <TextBox Height="34" FontSize="14" BorderThickness="1" BorderBrush="{StaticResource InputBorder}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" x:Name="SearchBox"
                       AutomationProperties.Name="{Binding DataContext.S.Search, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <TextBlock Text="{Binding DataContext.S.Search, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Note}" FontSize="13" IsHitTestVisible="False"
                         Margin="12,0" VerticalAlignment="Center" TextWrapping="NoWrap"
                         Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource TextVis}, ConverterParameter=invert}" />
            </Grid>
            <TextBlock Text="{Binding DateLabel}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="12,0" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <!-- Offline banner -->
        <Border DockPanel.Dock="Top" Background="#fff8e6" BorderBrush="{StaticResource WarnBorder}" BorderThickness="0,0,0,1" Padding="16,9"
                Visibility="{Binding DataContext.OfflineBanner, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}">
          <TextBlock Text="{Binding DataContext.S.OfflineBanner, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#6b4a00" FontSize="13" />
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource Soft}" BorderBrush="{StaticResource InputBorder}" BorderThickness="0,0,0,1" Padding="16,9"
                Visibility="{Binding ShowReadOnlyNote, Converter={StaticResource Vis}}">
          <TextBlock Text="{Binding DataContext.S.ReadOnlyDoctor, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource BrandDeep}" FontSize="13" />
        </Border>
        <!-- Filter chips, department, grace note -->
        <DockPanel DockPanel.Dock="Top" Margin="16,10">
          <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Chips}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource FilterChipButton}" Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ComboBox DockPanel.Dock="Left" Width="170" Margin="6,0,0,0" ItemsSource="{Binding Departments}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DepartmentId}" />
          <TextBlock Text="{Binding GraceNote}" Style="{StaticResource Note}" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap" />
        </DockPanel>

        <Grid Background="White">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border BorderBrush="{StaticResource TheadBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
              <!-- Columns: 52 | minmax(120,1.6fr) | minmax(90,1fr) | 78 | 112 | 52 -->
              <Grid DockPanel.Dock="Top" Background="{StaticResource Thead}" Margin="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" /><ColumnDefinition Width="1.6*" MinWidth="120" /><ColumnDefinition Width="*" MinWidth="90" />
                  <ColumnDefinition Width="86" /><ColumnDefinition Width="128" /><ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="6" BorderBrush="{StaticResource TheadBorder}" BorderThickness="0,0,0,1" />
                <TextBlock Grid.Column="0" Text="{Binding DataContext.S.CTime, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="12,8,0,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="1" Text="{Binding DataContext.S.CPatient, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="2" Text="{Binding DataContext.S.CDept, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="3" Text="{Binding DataContext.S.CRef, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="4" Text="{Binding DataContext.S.CStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="5" Text="{Binding DataContext.S.CIn, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
              </Grid>
              <Grid>
                <TextBlock Text="{Binding DataContext.S.Empty, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="16,40"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
                <ListBox x:Name="Table" ItemsSource="{Binding Rows}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         SelectionChanged="OnRowSelected" VirtualizingPanel.IsVirtualizing="True">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="b" Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"><ContentPresenter /></Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PageBg}" /></Trigger>
                              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Soft}" /></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="42">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="64" /><ColumnDefinition Width="1.6*" MinWidth="120" /><ColumnDefinition Width="*" MinWidth="90" />
                          <ColumnDefinition Width="86" /><ColumnDefinition Width="128" /><ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Cell}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FlowDirection="LeftToRight" Margin="12,0,0,0" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding Patient}" Style="{StaticResource Cell}" />
                        <TextBlock Grid.Column="2" Text="{Binding Department}" Style="{StaticResource Cell}" FontSize="13" Foreground="{StaticResource Muted}" Margin="8,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Ref}" Style="{StaticResource MonoText}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                          <Border Style="{StaticResource Chip}" Padding="9,3" Background="{Binding Status, Converter={StaticResource StatusBg}}">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" Foreground="{Binding Status, Converter={StaticResource StatusFg}}" />
                          </Border>
                          <TextBlock Text="⟳" Foreground="#b07a00" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Pending, Converter={StaticResource Vis}}"
                                     ToolTip="{Binding DataContext.S.PendingTip, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                          <TextBlock Text="!" Foreground="#b54708" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding NeedsReview, Converter={StaticResource Vis}}"
                                     ToolTip="{Binding DataContext.S.NeedsReview, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="5" Text="{Binding CheckinTime}" Style="{StaticResource Cell}" FontSize="13" Foreground="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </DockPanel>
          </Border>

          <!-- Detail panel (340px; 290px when narrow) -->
          <Border Grid.Column="1" x:Name="Detail" Width="340" BorderBrush="{StaticResource TheadBorder}" BorderThickness="1,1,0,0"
                  Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Width="30" Height="30" Padding="0" Style="{StaticResource Small}" Background="{StaticResource PageBg}" BorderThickness="0"
                          Content="×" Command="{Binding CloseDetailCommand}" AutomationProperties.Name="{Binding DataContext.S.Close, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <StackPanel>
                    <TextBlock Text="{Binding DName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="{Binding DRef}" Style="{StaticResource MonoText}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Left" />
                  </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,16,0,0">
                  <Border Style="{StaticResource Chip}" Padding="10,4" Background="{Binding DStatus, Converter={StaticResource StatusBg}}" Margin="0,0,8,4">
                    <TextBlock Text="{Binding DStatusLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding DStatus, Converter={StaticResource StatusFg}}" TextWrapping="NoWrap" />
                  </Border>
                  <TextBlock Text="{Binding DSource}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,8,4" />
                  <TextBlock Text="{Binding DPendingTip}" Foreground="#b07a00" FontSize="12" VerticalAlignment="Center" Visibility="{Binding DPending, Converter={StaticResource Vis}}" />
                </WrapPanel>
                <Border Background="{StaticResource WarnBg}" CornerRadius="999" Padding="10,4" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding DNeedsReview, Converter={StaticResource Vis}}">
                  <TextBlock Text="{Binding DNeedsReviewText}" Foreground="{StaticResource WarnText}" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <ItemsControl ItemsSource="{Binding DFacts}" Margin="0,16,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,14,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="Medium">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Ltr}" Value="True">
                                  <Setter Property="FlowDirection" Value="LeftToRight" />
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Primary}" Margin="0,8,0,0" Content="{Binding DataContext.S.MarkArrived, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding CheckInCommand}" Visibility="{Binding DCanCheckIn, Converter={StaticResource Vis}}" />
                <Border Margin="0,16,0,0" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="{Binding DCanCorrect, Converter={StaticResource Vis}}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.S.Correct, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding DTargets}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource TargetChip}" Command="{Binding DataContext.TargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Status}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                      <TextBox x:Name="ReasonBox" Height="56" FontSize="13" BorderThickness="1" BorderBrush="{StaticResource InputBorder}" TextWrapping="Wrap" AcceptsReturn="False"
                               VerticalContentAlignment="Top" Padding="8" MaxLength="300" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="{Binding DataContext.S.ReasonPh, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      <TextBlock Text="{Binding DataContext.S.ReasonPh, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Note}" FontSize="13" Margin="10,8" IsHitTestVisible="False"
                                 Visibility="{Binding Reason, Converter={StaticResource TextVis}, ConverterParameter=invert}" x:Name="ReasonHint" />
                    </Grid>
                    <TextBlock Text="{Binding ReasonError}" Foreground="{StaticResource DangerText}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding ReasonError, Converter={StaticResource TextVis}}" />
                    <Button Style="{StaticResource Primary}" Height="36" FontSize="13" Margin="0,10,0,0" Content="{Binding DataContext.S.SaveCorr, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Command="{Binding SaveCorrectionCommand}" />
                    <TextBlock Text="{Binding DataContext.S.CorrNote, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Note}" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding DataContext.S.History, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8" />
                <ItemsControl ItemsSource="{Binding DHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextWrapping="NoWrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <TextBlock Text="{Binding Text}" FontSize="12" LineHeight="17" MaxWidth="210" />
                          <TextBlock Text=" ⟳" Foreground="#b07a00" FontSize="12" Visibility="{Binding Pending, Converter={StaticResource Vis}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </DockPanel>

      <!-- ============================== Find booking ============================== -->
      <ScrollViewer x:Name="FindPage" Visibility="Collapsed" DataContext="{Binding Find}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="{Binding DataContext.S.FindTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Title}" />
          <TextBlock Text="{Binding DataContext.S.FindSub, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" Margin="0,6,0,16" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="8,0,0,0" Height="44" Content="{Binding DataContext.S.FindBtn, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding FindCommand}" IsDefault="True" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" FlowDirection="LeftToRight" CharacterCasing="Upper" MaxLength="9"
                     AutomationProperties.Name="{Binding DataContext.S.CRef, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </DockPanel>
          <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerDark}" Margin="0,10,0,0" Visibility="{Binding Message, Converter={StaticResource TextVis}}" />
        </StackPanel>
      </ScrollViewer>

      <!-- ============================== Sync ============================== -->
      <ScrollViewer x:Name="SyncPageView" Visibility="Collapsed" DataContext="{Binding SyncPage}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Text="{Binding DataContext.S.SyncTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Title}" />
          <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="{Binding DataContext.S.CStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                <TextBlock Grid.Column="1" Text="{Binding DataContext.PillText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{Binding DataContext.S.PendingCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Pending}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Text="{Binding DataContext.S.LastSync, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastSync}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
              </Grid>
              <Button Style="{StaticResource Primary}" Margin="0,16,0,0" HorizontalAlignment="Left" Content="{Binding DataContext.S.SyncNow, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding SyncNowCommand}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding DataContext.S.RejectedTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,8" />
          <TextBlock Text="{Binding DataContext.S.RejectedNone, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}"
                     Visibility="{Binding HasNoRejected, Converter={StaticResource Vis}}" />
          <ItemsControl ItemsSource="{Binding Rejected}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Ref}" Style="{StaticResource MonoText}" Width="110" />
                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource DangerText}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- ============================== Settings ============================== -->
      <ScrollViewer x:Name="SettingsPageView" Visibility="Collapsed" DataContext="{Binding SettingsPage}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Text="{Binding DataContext.S.SettingsTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Title}" />
          <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="{Binding DataContext.S.Language, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Label}" />
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Small}" Margin="0,0,6,0" Content="عربي" Command="{Binding LanguageCommand}" CommandParameter="Ar" />
                <Button Style="{StaticResource Small}" Margin="0,0,6,0" Content="EN" Command="{Binding LanguageCommand}" CommandParameter="En" />
                <Button Style="{StaticResource Small}" Content="TR" Command="{Binding LanguageCommand}" CommandParameter="Tr" />
              </StackPanel>
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="{Binding DataContext.S.DeviceName, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="1" Text="{Binding DataContext.S.DeviceId, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceId}" Style="{StaticResource MonoText}" FontSize="12" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="2" Text="{Binding DataContext.S.ServerAddress, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Server}" Style="{StaticResource MonoText}" FontSize="12" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="3" Text="{Binding DataContext.S.AppVersion, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Version}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
              </Grid>
              <TextBlock Text="{Binding DataContext.S.ServerNote, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Note}" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Toast (bottom centre, 4 s) -->
    <Border x:Name="ToastBox" Grid.ColumnSpan="2" Background="{StaticResource Ink}" CornerRadius="10" Padding="16,10" Margin="0,0,0,24" MaxWidth="560"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
      <TextBlock Text="{Binding Toast}" Foreground="White" FontSize="13" />
    </Border>

    <!-- Sign-out with unsent check-ins -->
    <Grid Grid.ColumnSpan="2" Background="#660f1a4a" Visibility="{Binding SignOutWarning, Converter={StaticResource Vis}}">
      <Border Background="White" CornerRadius="10" Padding="24" MaxWidth="440" VerticalAlignment="Center" Margin="16">
        <StackPanel>
          <TextBlock Text="{Binding S.SignOut}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
          <TextBlock Text="{Binding S.SignOutPending}" Margin="0,14,0,0" LineHeight="22" />
          <UniformGrid Columns="2" Margin="0,16,0,0">
            <Button Style="{StaticResource Secondary}" Margin="0,0,4,0" Content="{Binding S.Cancel}" Command="{Binding CancelSignOutCommand}" />
            <Button Style="{StaticResource Primary}" Background="{StaticResource DangerText}" BorderBrush="{StaticResource DangerText}" Margin="4,0,0,0"
                    Content="{Binding S.SignOutConfirm}" Command="{Binding SignOutCommand}" />
          </UniformGrid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
